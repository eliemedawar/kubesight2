FROM aquasec/trivy:0.70.0 AS trivy
FROM anchore/syft:v1.44.0 AS syft
FROM hadolint/hadolint:v2.14.0-debian AS hadolint

FROM python:3.12-slim-bookworm

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt \
    REQUESTS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt

WORKDIR /app

RUN --mount=type=secret,id=trend_micro_cloud_ca,required=true \
    --mount=type=secret,id=trend_micro_onprem_ca,required=true \
    cp /run/secrets/trend_micro_cloud_ca \
        /usr/local/share/ca-certificates/trend-micro-cloud.crt && \
    cp /run/secrets/trend_micro_onprem_ca \
        /usr/local/share/ca-certificates/trend-micro-onprem.crt && \
    update-ca-certificates && \
    sed -i 's|http://deb.debian.org|https://deb.debian.org|g' /etc/apt/sources.list.d/debian.sources && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
        default-jdk-headless git golang-go gradle maven nodejs npm && \
    rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install -r requirements.txt

ARG SEMGREP_VERSION=1.164.0
ENV PATH=/opt/semgrep/bin:$PATH \
    TRIVY_CACHE_DIR=/tmp/trivy-cache
RUN --mount=type=cache,target=/root/.cache/pip \
    python -m venv /opt/semgrep && \
    /opt/semgrep/bin/pip install "semgrep==${SEMGREP_VERSION}"

# Keep scanner versions aligned with the production worker. Scanner databases
# and registry rules are downloaded only while an analysis is running.
COPY --from=trivy /usr/local/bin/trivy /usr/local/bin/trivy
COPY --from=syft /syft /usr/local/bin/syft
COPY --from=hadolint /bin/hadolint /usr/local/bin/hadolint

COPY . .

ENTRYPOINT ["python"]
CMD ["-m", "api.application_worker"]
