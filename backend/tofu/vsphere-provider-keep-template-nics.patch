@@ -1070,6 +1074,23 @@ func (r *NetworkInterfaceSubresource) Update(l object.VirtualDeviceList) ([]type
 	}
 	card.ExternalId = newExternalID.(string)
 
+	// KubeSight patch: a card the provider keeps (a clone's, now that it is no
+	// longer re-created) keeps the template's connection settings, and a
+	// template's card is often set not to connect at power on. The VM then boots
