# Offline local-development overlay. Build the full worker image for production.
FROM kubesight-application-worker:local

WORKDIR /app

ARG TARGETARCH=amd64
ARG SEMGREP_VERSION=1.170.0
ARG TRIVY_VERSION=0.72.0
ARG SYFT_VERSION=1.50.0
ARG HADOLINT_VERSION=2.15.1

RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --retries 10 --timeout 300 "semgrep==${SEMGREP_VERSION}"

RUN --mount=type=cache,target=/root/.cache/scanner-downloads \
    set -eux; \
    case "${TARGETARCH}" in \
        amd64) trivy_arch="64bit"; syft_arch="amd64"; hadolint_arch="x86_64" ;; \
        arm64) trivy_arch="ARM64"; syft_arch="arm64"; hadolint_arch="arm64" ;; \
        *) echo "Unsupported worker architecture: ${TARGETARCH}" >&2; exit 1 ;; \
    esac; \
    cache=/root/.cache/scanner-downloads; \
    download() { python -c 'import sys, urllib.request; urllib.request.urlretrieve(sys.argv[1], sys.argv[2])' "$1" "$2"; }; \
    trivy_archive="trivy_${TRIVY_VERSION}_Linux-${trivy_arch}.tar.gz"; \
    download "https://github.com/aquasecurity/trivy/releases/download/v${TRIVY_VERSION}/${trivy_archive}" "${cache}/${trivy_archive}"; \
    download "https://github.com/aquasecurity/trivy/releases/download/v${TRIVY_VERSION}/trivy_${TRIVY_VERSION}_checksums.txt" "${cache}/trivy_checksums.txt"; \
    cd "${cache}"; \
    grep " ${trivy_archive}$" trivy_checksums.txt | sha256sum -c -; \
    tar -xzf "${trivy_archive}" -C /usr/local/bin trivy; \
    syft_archive="syft_${SYFT_VERSION}_linux_${syft_arch}.tar.gz"; \
    download "https://github.com/anchore/syft/releases/download/v${SYFT_VERSION}/${syft_archive}" "${cache}/${syft_archive}"; \
    download "https://github.com/anchore/syft/releases/download/v${SYFT_VERSION}/syft_${SYFT_VERSION}_checksums.txt" "${cache}/syft_checksums.txt"; \
    grep " ${syft_archive}$" syft_checksums.txt | sha256sum -c -; \
    tar -xzf "${syft_archive}" -C /usr/local/bin syft; \
    hadolint_binary="hadolint-linux-${hadolint_arch}"; \
    download "https://github.com/hadolint/hadolint/releases/download/v${HADOLINT_VERSION}/${hadolint_binary}" "${cache}/${hadolint_binary}"; \
    download "https://github.com/hadolint/hadolint/releases/download/v${HADOLINT_VERSION}/checksums.sha256" "${cache}/hadolint_checksums.sha256"; \
    grep "\\*${hadolint_binary}$" hadolint_checksums.sha256 | sha256sum -c -; \
    install -m 0755 "${hadolint_binary}" /usr/local/bin/hadolint; \
    chmod 0755 /usr/local/bin/trivy /usr/local/bin/syft; \
    semgrep --version; \
    trivy --version; \
    syft version; \
    hadolint --version

COPY . .
USER 65532:65532

ENTRYPOINT ["python"]
CMD ["-m", "api.application_worker"]
