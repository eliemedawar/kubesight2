{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "KubeSight Helm values",
  "type": "object",
  "additionalProperties": false,
  "required": ["deploymentMode", "global", "images", "secrets", "config", "web", "worker", "scheduler", "frontend", "ingress", "networkPolicy", "migrations", "trial"],
  "properties": {
    "deploymentMode": {"type": "string", "enum": ["trial", "production"]},
    "global": {
      "type": "object", "additionalProperties": false,
      "required": ["imageRegistry", "imagePullSecrets", "commonLabels"],
      "properties": {
        "imageRegistry": {"type": "string"},
        "imagePullSecrets": {"type": "array", "items": {"type": "object", "required": ["name"], "properties": {"name": {"type": "string", "minLength": 1}}}},
        "commonLabels": {"type": "object", "additionalProperties": {"type": "string"}}
      }
    },
    "images": {
      "type": "object", "additionalProperties": false, "required": ["backend", "frontend"],
      "properties": {
        "backend": {"$ref": "#/definitions/image"},
        "frontend": {"$ref": "#/definitions/image"}
      }
    },
    "nameOverride": {"type": "string"},
    "fullnameOverride": {"type": "string"},
    "secrets": {
      "type": "object", "additionalProperties": false, "required": ["existingSecret", "secretProviderClass"],
      "properties": {"existingSecret": {"type": "string"}, "secretProviderClass": {"type": "string"}}
    },
    "config": {
      "type": "object", "additionalProperties": false,
      "required": ["publicUrl", "corsOrigins", "databasePoolSize", "databaseMaxOverflow", "sessionAccessMinutes", "sessionRefreshDays", "extraEnv"],
      "properties": {
        "publicUrl": {"type": "string", "pattern": "^https://"},
        "corsOrigins": {"type": "string", "minLength": 1, "not": {"pattern": "(^|,)\\s*(\\*|null)\\s*(,|$)"}},
        "databasePoolSize": {"type": "string", "pattern": "^[1-9][0-9]*$"},
        "databaseMaxOverflow": {"type": "string", "pattern": "^[0-9]+$"},
        "sessionAccessMinutes": {"type": "string", "pattern": "^[1-9][0-9]*$"},
        "sessionRefreshDays": {"type": "string", "pattern": "^[1-9][0-9]*$"},
        "extraEnv": {"type": "array", "items": {"type": "object", "required": ["name"], "properties": {"name": {"type": "string"}, "value": {"type": "string"}, "valueFrom": {"type": "object"}}}}
      }
    },
    "objectStorage": {
      "type": "object", "additionalProperties": false,
      "required": ["enabled", "existingClaim", "mountPath", "accessModes", "storage", "storageClass"],
      "properties": {
        "enabled": {"type": "boolean"}, "existingClaim": {"type": "string"}, "mountPath": {"type": "string", "pattern": "^/"},
        "accessModes": {"type": "array", "minItems": 1, "items": {"enum": ["ReadWriteOnce", "ReadOnlyMany", "ReadWriteMany", "ReadWriteOncePod"]}},
        "storage": {"type": "string", "pattern": "^[1-9][0-9]*(Mi|Gi|Ti)$"}, "storageClass": {"type": "string"}
      }
    },
    "serviceAccounts": {"$ref": "#/definitions/serviceAccounts"},
    "podSecurityContext": {"type": "object"},
    "containerSecurityContext": {"type": "object"},
    "web": {"$ref": "#/definitions/web"},
    "worker": {"$ref": "#/definitions/daemon"},
    "scheduler": {"$ref": "#/definitions/daemon"},
    "frontend": {"$ref": "#/definitions/frontend"},
    "ingress": {"$ref": "#/definitions/ingress"},
    "networkPolicy": {"$ref": "#/definitions/networkPolicy"},
    "podDisruptionBudget": {"type": "object", "required": ["enabled", "maxUnavailable"], "properties": {"enabled": {"type": "boolean"}, "maxUnavailable": {"oneOf": [{"type": "integer", "minimum": 0}, {"type": "string"}]}}},
    "rbac": {"type": "object", "additionalProperties": false, "required": ["create"], "properties": {"create": {"type": "boolean"}}},
    "migrations": {
      "type": "object", "additionalProperties": false, "required": ["enabled", "command", "activeDeadlineSeconds", "resources"],
      "properties": {"enabled": {"type": "boolean"}, "command": {"$ref": "#/definitions/command"}, "activeDeadlineSeconds": {"type": "integer", "minimum": 60}, "resources": {"$ref": "#/definitions/resources"}}
    },
    "trial": {
      "type": "object", "additionalProperties": false, "required": ["postgresql", "redis"],
      "properties": {"postgresql": {"$ref": "#/definitions/trialService"}, "redis": {"$ref": "#/definitions/trialService"}}
    },
    "diagnostics": {"type": "object", "required": ["includePodLogs", "logTailLines"], "properties": {"includePodLogs": {"type": "boolean"}, "logTailLines": {"type": "integer", "minimum": 0, "maximum": 10000}}}
  },
  "allOf": [
    {
      "if": {"properties": {"deploymentMode": {"const": "production"}}},
      "then": {
        "properties": {
          "secrets": {"properties": {"existingSecret": {"minLength": 1}}},
          "networkPolicy": {"properties": {"enabled": {"const": true}}},
          "objectStorage": {"anyOf": [{"properties": {"enabled": {"const": false}}}, {"properties": {"existingClaim": {"minLength": 1}}}]}
        }
      }
    },
    {"if": {"properties": {"worker": {"properties": {"enabled": {"const": true}}}}}, "then": {"properties": {"worker": {"properties": {"command": {"minItems": 1}}}}}},
    {"if": {"properties": {"scheduler": {"properties": {"enabled": {"const": true}}}}}, "then": {"properties": {"scheduler": {"properties": {"command": {"minItems": 1}, "replicas": {"const": 1}}}}}}
  ],
  "definitions": {
    "image": {
      "type": "object", "additionalProperties": false, "required": ["repository", "tag", "digest", "pullPolicy"],
      "properties": {"repository": {"type": "string", "minLength": 1}, "tag": {"type": "string"}, "digest": {"type": "string", "pattern": "^$|^sha256:[a-f0-9]{64}$"}, "pullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]}}
    },
    "command": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "resources": {
      "type": "object", "required": ["requests", "limits"],
      "properties": {"requests": {"type": "object", "required": ["cpu", "memory"]}, "limits": {"type": "object", "required": ["cpu", "memory"]}}
    },
    "placement": {
      "type": "object",
      "properties": {"podAnnotations": {"type": "object"}, "nodeSelector": {"type": "object"}, "tolerations": {"type": "array"}, "affinity": {"type": "object"}, "topologySpreadConstraints": {"type": "array"}}
    },
    "web": {
      "allOf": [{"$ref": "#/definitions/placement"}], "type": "object",
      "required": ["replicas", "command", "args", "service", "resources", "podAnnotations", "nodeSelector", "tolerations", "affinity", "topologySpreadConstraints"],
      "properties": {"replicas": {"type": "integer", "minimum": 1}, "command": {"$ref": "#/definitions/command"}, "args": {"$ref": "#/definitions/command"}, "service": {"$ref": "#/definitions/service"}, "resources": {"$ref": "#/definitions/resources"}, "podAnnotations": {"type": "object"}, "nodeSelector": {"type": "object"}, "tolerations": {"type": "array"}, "affinity": {"type": "object"}, "topologySpreadConstraints": {"type": "array"}}
    },
    "daemon": {
      "allOf": [{"$ref": "#/definitions/placement"}], "type": "object",
      "required": ["enabled", "replicas", "command", "args", "resources", "podAnnotations", "nodeSelector", "tolerations", "affinity", "topologySpreadConstraints"],
      "properties": {"enabled": {"type": "boolean"}, "replicas": {"type": "integer", "minimum": 1}, "command": {"$ref": "#/definitions/command"}, "args": {"$ref": "#/definitions/command"}, "resources": {"$ref": "#/definitions/resources"}, "podAnnotations": {"type": "object"}, "nodeSelector": {"type": "object"}, "tolerations": {"type": "array"}, "affinity": {"type": "object"}, "topologySpreadConstraints": {"type": "array"}}
    },
    "frontend": {
      "allOf": [{"$ref": "#/definitions/placement"}], "type": "object",
      "required": ["enabled", "replicas", "service", "resources", "podAnnotations", "nodeSelector", "tolerations", "affinity", "topologySpreadConstraints"],
      "properties": {"enabled": {"type": "boolean"}, "replicas": {"type": "integer", "minimum": 1}, "service": {"$ref": "#/definitions/service"}, "resources": {"$ref": "#/definitions/resources"}, "podAnnotations": {"type": "object"}, "nodeSelector": {"type": "object"}, "tolerations": {"type": "array"}, "affinity": {"type": "object"}, "topologySpreadConstraints": {"type": "array"}}
    },
    "service": {"type": "object", "additionalProperties": false, "required": ["type", "port"], "properties": {"type": {"enum": ["ClusterIP", "NodePort", "LoadBalancer"]}, "port": {"type": "integer", "minimum": 1, "maximum": 65535}}},
    "serviceAccounts": {"type": "object", "additionalProperties": false, "required": ["create", "annotations", "webName", "workerName", "schedulerName", "frontendName"], "properties": {"create": {"type": "boolean"}, "annotations": {"type": "object"}, "webName": {"type": "string"}, "workerName": {"type": "string"}, "schedulerName": {"type": "string"}, "frontendName": {"type": "string"}}},
    "ingress": {"type": "object", "additionalProperties": false, "required": ["enabled", "className", "annotations", "host", "tls"], "properties": {"enabled": {"type": "boolean"}, "className": {"type": "string"}, "annotations": {"type": "object"}, "host": {"type": "string", "minLength": 1}, "tls": {"type": "object", "required": ["enabled", "secretName"], "properties": {"enabled": {"type": "boolean"}, "secretName": {"type": "string"}}}}},
    "networkPolicy": {
      "type": "object", "additionalProperties": false,
      "required": ["enabled", "ingressNamespaceSelector", "ingressPodSelector", "externalEgress", "extraEgress"],
      "properties": {
        "enabled": {"type": "boolean"},
        "ingressNamespaceSelector": {"type": "object"},
        "ingressPodSelector": {"type": "object"},
        "externalEgress": {
          "type": "array",
          "items": {
            "type": "object", "required": ["cidr"],
            "properties": {
              "cidr": {"type": "string"},
              "except": {"type": "array", "items": {"type": "string"}},
              "ports": {"type": "array"}
            }
          }
        },
        "extraEgress": {"type": "array"}
      }
    },
    "trialService": {"type": "object", "additionalProperties": false, "required": ["storage", "storageClass", "image", "resources"], "properties": {"storage": {"type": "string"}, "storageClass": {"type": "string"}, "image": {"$ref": "#/definitions/image"}, "resources": {"$ref": "#/definitions/resources"}}}
  }
}
